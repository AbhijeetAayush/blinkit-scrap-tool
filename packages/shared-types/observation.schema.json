{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/observation.schema.json",
  "title": "ObservationDraft",
  "type": "object",
  "required": [
    "platform",
    "merchant_id",
    "pincode",
    "product_id",
    "sku_name",
    "availability",
    "observed_at",
    "observed_slot"
  ],
  "properties": {
    "brand_id": { "type": ["string", "null"], "format": "uuid" },
    "run_id": { "type": ["string", "null"], "format": "uuid" },
    "platform": { "type": "string" },
    "merchant_id": { "type": "string" },
    "pincode": { "type": "string" },
    "product_id": { "type": "string" },
    "variant_id": { "type": ["string", "null"] },
    "group_id": { "type": ["string", "null"] },
    "sku_name": { "type": "string" },
    "brand_name": { "type": ["string", "null"] },
    "pack_raw": { "type": ["string", "null"] },
    "pack_ml": { "type": ["integer", "null"] },
    "category_path": { "type": "array", "items": { "type": "string" } },
    "product_url": { "type": ["string", "null"] },
    "image_url": { "type": ["string", "null"] },
    "mrp": { "type": ["number", "null"] },
    "selling_price": { "type": ["number", "null"] },
    "discount_percent": { "type": ["number", "null"] },
    "discount_text": { "type": ["string", "null"] },
    "offer_text": { "type": ["string", "null"] },
    "currency": { "type": "string", "default": "INR" },
    "availability": { "enum": ["in_stock", "oos", "delisted"] },
    "inventory_shown": { "type": ["integer", "null"] },
    "qty_cap": { "type": ["integer", "null"] },
    "low_stock_badge": { "type": "boolean" },
    "shelf_position": { "type": ["integer", "null"] },
    "organic_rank": { "type": ["integer", "null"] },
    "is_sponsored": { "type": ["boolean", "null"] },
    "search_query": { "type": ["string", "null"] },
    "result_page": { "type": ["integer", "null"] },
    "delivery_promise_min": { "type": ["integer", "null"] },
    "delivery_time_text": { "type": ["string", "null"] },
    "rating": { "type": ["number", "null"] },
    "rating_count": { "type": ["integer", "null"] },
    "sku_id": { "type": ["string", "null"], "format": "uuid" },
    "sku_role": { "enum": ["self", "brand_competitor", null] },
    "match_confidence": { "type": ["number", "null"] },
    "match_method": { "type": ["string", "null"] },
    "unit_price_per_l": { "type": ["number", "null"] },
    "unlocker_vendor": { "type": ["string", "null"] },
    "observed_at": { "type": "string", "format": "date-time" },
    "observed_slot": { "type": "string", "format": "date-time" },
    "s3_bronze_key": { "type": ["string", "null"] },
    "payload_hash": { "type": ["string", "null"] }
  }
}
